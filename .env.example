# --- Server ---
# Provided automatically by the Railway PostgreSQL plugin in production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dyslexia
# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret
# Invite code for creating teacher accounts (also the seeded teacher's initial
# password). Teacher passwords themselves are stored bcrypt-hashed.
TEACHER_PASSWORD=teacher123
PORT=3000
NODE_ENV=development
# Set to "true" to run the idempotent schema (creates tables / adds new columns)
# automatically on server startup. Leave unset/false to manage the schema by hand.
RUN_MIGRATIONS=false
# Public URL of the frontend (used for CORS in production)
FRONTEND_URL=http://localhost:5173

# --- Client (client/.env) ---
# Base URL of the API, baked into the build by Vite at build time.
# IMPORTANT: For the single-service Railway deploy (client + API on one domain),
# leave this EMPTY so the app uses same-origin relative paths. Only set it when
# the API runs on a SEPARATE host. Never set it to localhost in production.
VITE_API_URL=
